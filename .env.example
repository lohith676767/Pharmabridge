# Copy this file to .env and fill in your own keys. .env is gitignored —
# never commit real API keys.
#
# Each agent can use a different provider/model, as long as the endpoint
# is OpenAI-compatible (OpenRouter, Groq, Together.ai, a local vLLM/Ollama
# server, etc).

AGENT1_API_KEY=
AGENT1_BASE_URL=https://openrouter.ai/api/v1/chat/completions

AGENT2_API_KEY=
AGENT2_BASE_URL=https://openrouter.ai/api/v1/chat/completions
